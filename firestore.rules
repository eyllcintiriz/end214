rules_version = '2';

// END214 – Firestore güvenlik kuralları
// Özet:
//   • Herkes (giriş yapmadan) konuları, duyuruları ve ders bilgilerini OKUYABİLİR.
//   • Yalnızca yönetici (hoca) YAZABİLİR. Yönetici = "yoneticiler" koleksiyonunda
//     kendi kullanıcı kimliğiyle (uid) bir belgesi olan hesap. Bu belge Firebase
//     konsolundan elle eklenir; siteden kimse kendini yönetici yapamaz.
//   • Öğrenciler "hata bildirimi" GÖNDEREBİLİR ama gönderilenleri okuyamaz.
//   • Giriş yapan öğrenci yalnızca kendi ilerleme belgesini (ogrenciler/{uid}) okur ve yazar.
//   • Düzeltme önerilerini yalnızca yönetici görür ve onaylar.

service cloud.firestore {
  match /databases/{database}/documents {

    function yonetici() {
      return request.auth != null
        && exists(/databases/$(database)/documents/yoneticiler/$(request.auth.uid));
    }

    // Konular: sorular, çözümler, formül kartları
    match /konular/{konu} {
      allow read: if true;
      allow write: if yonetici();
    }

    // Duyurular ve site bilgileri (ayarlar, ders bilgileri)
    match /duyurular/{id} {
      allow read: if true;
      allow write: if yonetici();
    }
    match /site/{belge} {
      allow read: if true;
      allow write: if yonetici();
    }

    // Düzeltme önerileri: yalnızca hoca görür; onay/ret yalnızca hocadan
    match /oneriler/{id} {
      allow read, write: if yonetici();
    }

    // Öğrenci hata bildirimleri: herkes gönderebilir (sınırlı alanlarla), yalnızca hoca okur
    match /hataBildirimleri/{id} {
      allow read, update, delete: if yonetici();
      allow create: if request.resource.data.keys().hasOnly(['soruId', 'sayfa', 'mesaj', 'eposta', 'ad', 'uid', 'tarih', 'durum'])
        && request.resource.data.soruId is string && request.resource.data.soruId.size() <= 20
        && request.resource.data.sayfa is string && request.resource.data.sayfa.size() <= 40
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() > 0 && request.resource.data.mesaj.size() <= 2000
        && (!('eposta' in request.resource.data) || (request.resource.data.eposta is string
              && request.resource.data.eposta.size() <= 100))
        && (!('ad' in request.resource.data) || (request.resource.data.ad is string
              && request.resource.data.ad.size() <= 80))
        && (!('uid' in request.resource.data) || (request.auth != null
              && request.resource.data.uid == request.auth.uid))
        && request.resource.data.tarih == request.time
        && request.resource.data.durum == 'yeni';
    }

    // Öğrenci verisi (çözdüğüm sorular, ilerleme): her öğrenci yalnızca kendi belgesini okur, yazar ve siler.
    // Yazılabilecek alanlar sınırlı: ad (≤80), cozulen ({'GA-04': true, …}, en çok 500 soru), oluşturma/güncelleme tarihi.
    // Böylece kimse kendi belgesine büyük ya da ilgisiz veri yığamaz.
    function ogrenciVerisi(d) {
      return d.keys().hasOnly(['ad', 'cozulen', 'olusturuldu', 'guncellendi'])
        && (!('ad' in d) || (d.ad is string && d.ad.size() <= 80))
        && (!('cozulen' in d) || (d.cozulen is map && d.cozulen.size() <= 500))
        && (!('olusturuldu' in d) || d.olusturuldu is timestamp)
        && (!('guncellendi' in d) || d.guncellendi is timestamp);
    }
    match /ogrenciler/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && ogrenciVerisi(request.resource.data);
    }

    // Yönetici listesi: herkes yalnızca KENDİ kaydının olup olmadığını görebilir (panel girişi için);
    // kimse siteden yazamaz (yalnızca Firebase konsolu)
    match /yoneticiler/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
